# Editor login. Leave unset if you pass authorize() to createCMS instead.
CMS_PASSWORD=
# Optional: signs the session cookie. Defaults to a value derived from the password.
CMS_SECRET=

# Where production saves are committed. On Vercel the repo and branch default to the deployment's.
CMS_GITHUB_REPO=owner/name
CMS_GITHUB_BRANCH=main
# Fine-grained token with read and write access to Contents on that one repository.
CMS_GITHUB_TOKEN=
